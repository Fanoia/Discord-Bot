<!DOCTYPE html>
<html data-bs-theme="dark" lang="en" data-bss-forced-theme="dark">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>FanoiaEN Talent Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="assets/css/Noto%20Sans.css?h=c17b4cde68b269b270804c7636b627ff">
</head>

<body>
    <div class="bg-body shadow d-flex flex-column flex-shrink-0 position-fixed top-0 bottom-0" style="width: 4.5rem;"><a class="text-center link-body-emphasis d-block p-3 text-decoration-none border-bottom" href="/" title="" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="Icon-only"><span class="visually-hidden">Icon-only</span><img src="assets/img/Test(1).png?h=213aa52786156ba509c4386e2834849f" width="50" height="50" style="margin-left: -7px;"></a>
        <ul class="nav nav-pills flex-column text-center nav-flush mb-auto">
            <li class="nav-item"><a class="nav-link active link-light py-3 border-bottom rounded-0" data-bs-toggle="tooltip" data-bss-tooltip="" data-bs-placement="right" href="/" aria-current="page" title="Home"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" class="bi bi-house-door">
                        <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"></path>
                    </svg></a></li>
            <li class="nav-item"><a class="nav-link py-3 border-bottom rounded-0" data-bs-toggle="tooltip" data-bss-tooltip="" data-bs-placement="right" href="/collabs" title="Collabs"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" class="bi bi-people-fill">
                        <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"></path>
                    </svg></a></li>
        </ul>
        <div class="dropdown p-3 border-top"><a class="dropdown-toggle link-body-emphasis d-flex align-items-center text-decoration-none" aria-expanded="false" data-bs-toggle="dropdown" role="button"><img class="rounded-circle" alt="" width="32" height="32" src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" style="object-fit: cover;"></a>
            <div class="dropdown-menu shadow text-small" data-popper-placement="top-start"><a class="dropdown-item" href="#">Settings</a><a class="dropdown-item" href="#">Profile</a>
                <div class="dropdown-divider"></div><a class="dropdown-item" href="/logout">Sign out</a>
            </div>
        </div>
    </div>
    <div class="container d-flex d-xl-flex justify-content-xl-center align-items-xl-center" style="background: #dee2e600;padding-left: 107px;padding-right: 165px;margin-top: 102px;">
        <h1 class="text-center">FanoiaEN Portal</h1>
    </div>
    <div class="container" style="background: #254a57;padding-left: 47px;padding-right: 47px;">
        <h3 class="text-start" style="padding-top: 10px;padding-bottom: 10px;margin-top: 0px;margin-bottom: 0px;">Welcome</h3>
        <p class="fs-3" style="margin-bottom: 0px;padding-bottom: 10px;">You have 0 notifications</p>
    </div>
    <div class="container" style="background: #254a57;margin-top: 33px;">
        <div class="row d-xl-flex justify-content-xl-center align-items-xl-center">
            <div class="col-md-6" style="padding-left: 97px;padding-right: 97px;padding-top: 0px;padding-bottom: 0px;background: #16323b;margin-top: 20px;margin-bottom: 20px;">
                <h1 style="margin-left: -65px;margin-top: 14px;margin-bottom: -23px;padding-bottom: 33px;">Collabs:</h1>
                <%

                var found = await DBEdit2.findAll();
                for (var i = 0; i < found.length; i++) {
                    var collab = found[i];
                    if (JSON.parse(collab.attendies).indexOf(user.id) !== -1) {
                        var localDate = moment.unix(collab.time).tz(timezone);
                        var formattedDate = localDate.format('MM/DD/YY hh:mm A');
                        var game = collab.game;
                        var attendeesNum = JSON.parse(collab.attendies).length
                        let ifAttending;
                        if (JSON.parse(collab.attendies.indexOf(user.id) > -1)) {
                            ifAttending = true
                        } else {
                            ifAttending = false
                        }
                %>
                <section class="py-4 py-xl-5">
                    <div class="container" style="padding-top: 0px;padding-bottom: 0px;padding-left: 1px;padding-right: 1px;margin-top: 0px;margin-bottom: 0px;">
                        <div class="text-white bg-dark border rounded border-0" style="margin-top: 0px;margin-bottom: 0px;padding-top: 14px;padding-bottom: 14px;padding-left: 20px;padding-right: 20px;">
                            <h2 class="fw-bold text-white mb-3"><%= collab.game %></h2>
                            <p class="mb-4">Date: <%= formattedDate %><br>Platform: <%= collab.platform %><br>Participants: <%= attendeesNum %> <% if (ifAttending) { %>(YOU ARE ATTENDING)<% } %></p>
                            <div class="my-3"><a class="btn btn-primary btn-lg me-2" role="button" href="/collab/<%= collab.messageID %>">View Collab</a></div>
                        </div>
                    </div>
                </section>
                <% } else { %>
                    <p class="fs-3">There are no upcoming collabs you&#39;re apart of.</p>
               <% }} %>

            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/bs-init.js?h=f85385df9bc7fca4241bc1dbf53b9d61"></script>
</body>

</html>